# Supabase (Phase 10 — Contact form, optional analytics)
# Project Settings → API: use Project URL and either:
#   - Secret key (sb_secret_...) — Create new API Keys if needed
#   - Legacy API Keys tab → service_role key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Resend (email notifications for contact form)
# Create at resend.com → API Keys
RESEND_API_KEY=re_your_key_here
